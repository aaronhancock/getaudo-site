NODE_ENV=production
PORT=8080
CORS_ORIGIN=https://getaudo.com
PUBLIC_BASE_URL=https://getaudo.com

# Auth and storage
AUTH_MODE=firebase
AUDO_PREVIEW_API_SECRET=
STORE_MODE=firestore
FIREBASE_SERVICE_ACCOUNT_JSON=

# Free-site domain
AUDO_FREE_DOMAIN=getaudo.com
PUBLISHED_SITE_ROOT=/app/published-sites

# Cloudflare DNS provisioning
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_NAME=getaudo.com
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_FREE_SITE_TARGET=getaudo.com
CLOUDFLARE_ORIGIN_IPV4=
CLOUDFLARE_PROXIED=true

# Coolify deployment hooks
COOLIFY_BASE_URL=
COOLIFY_API_TOKEN=
COOLIFY_BUILDER_APP_UUID=

# Optional backup and billing integrations
BACKUP_WEBHOOK_URL=
STRIPE_SECRET_KEY=
STRIPE_PAID_PRICE_ID=
