{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "border": { "color": true, "radius": true, "style": true, "width": true },
    "color": {
      "custom": true,
      "customDuotone": true,
      "customGradient": true,
      "palette": [
        { "slug": "base", "name": "Base", "color": "#f7f9fc" },
        { "slug": "surface", "name": "Surface", "color": "#ffffff" },
        { "slug": "ink", "name": "Ink", "color": "#121826" },
        { "slug": "primary", "name": "Primary", "color": "#2457e6" },
        { "slug": "accent", "name": "Accent", "color": "#11a984" },
        { "slug": "violet", "name": "Violet", "color": "#6d4aff" }
      ],
      "gradients": [
        { "slug": "signal", "name": "Signal", "gradient": "linear-gradient(135deg, #2457e6 0%, #11a984 100%)" }
      ]
    },
    "layout": { "contentSize": "780px", "wideSize": "1220px" },
    "spacing": { "units": ["px", "rem", "%", "vw", "vh"] },
    "typography": {
      "customFontSize": true,
      "fluid": false,
      "fontFamilies": [
        { "slug": "inter", "name": "Inter", "fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif" },
        { "slug": "mono", "name": "Mono", "fontFamily": "\"SFMono-Regular\", Consolas, monospace" }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.85rem" },
        { "slug": "medium", "name": "Medium", "size": "1rem" },
        { "slug": "large", "name": "Large", "size": "1.3rem" },
        { "slug": "x-large", "name": "Display", "size": "4.75rem" }
      ]
    }
  },
  "styles": {
    "color": { "background": "var:preset|color|base", "text": "var:preset|color|ink" },
    "typography": { "fontFamily": "var:preset|font-family|inter", "lineHeight": "1.54" },
    "elements": {
      "heading": { "typography": { "fontWeight": "850", "lineHeight": "1" } },
      "link": { "color": { "text": "var:preset|color|primary" } }
    }
  }
}
