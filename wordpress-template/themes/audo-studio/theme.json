{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "border": { "color": true, "radius": true, "style": true, "width": true },
    "color": {
      "custom": true,
      "customDuotone": true,
      "customGradient": true,
      "palette": [
        { "slug": "base", "name": "Base", "color": "#fbfaf7" },
        { "slug": "ink", "name": "Ink", "color": "#151515" },
        { "slug": "slate", "name": "Slate", "color": "#39414a" },
        { "slug": "primary", "name": "Primary", "color": "#dd4f35" },
        { "slug": "accent", "name": "Accent", "color": "#2456a6" },
        { "slug": "citron", "name": "Citron", "color": "#d9d65a" }
      ],
      "gradients": [
        { "slug": "studio-light", "name": "Studio Light", "gradient": "linear-gradient(135deg, #fbfaf7 0%, #d9d65a 52%, #dd4f35 100%)" }
      ]
    },
    "layout": { "contentSize": "820px", "wideSize": "1240px" },
    "spacing": { "units": ["px", "rem", "%", "vw", "vh"] },
    "typography": {
      "customFontSize": true,
      "fluid": false,
      "fontFamilies": [
        { "slug": "system", "name": "System", "fontFamily": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif" },
        { "slug": "serif", "name": "Editorial Serif", "fontFamily": "Georgia, \"Times New Roman\", serif" },
        { "slug": "mono", "name": "Mono", "fontFamily": "\"SFMono-Regular\", Consolas, monospace" }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.85rem" },
        { "slug": "medium", "name": "Medium", "size": "1rem" },
        { "slug": "large", "name": "Large", "size": "1.5rem" },
        { "slug": "x-large", "name": "Display", "size": "5.2rem" }
      ]
    }
  },
  "styles": {
    "color": { "background": "var:preset|color|base", "text": "var:preset|color|ink" },
    "typography": { "fontFamily": "var:preset|font-family|system", "lineHeight": "1.5" },
    "elements": {
      "heading": { "typography": { "fontWeight": "900", "lineHeight": "0.98" } },
      "link": { "color": { "text": "var:preset|color|primary" } }
    }
  }
}
