{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "border": { "color": true, "radius": true, "style": true, "width": true },
    "color": {
      "custom": true,
      "customDuotone": true,
      "customGradient": true,
      "palette": [
        { "slug": "base", "name": "Base", "color": "#f6f8f4" },
        { "slug": "surface", "name": "Surface", "color": "#ffffff" },
        { "slug": "ink", "name": "Ink", "color": "#14221c" },
        { "slug": "muted", "name": "Muted", "color": "#627169" },
        { "slug": "primary", "name": "Primary", "color": "#119c68" },
        { "slug": "accent", "name": "Accent", "color": "#2f65d8" },
        { "slug": "warm", "name": "Warm", "color": "#d99841" }
      ],
      "gradients": [
        { "slug": "fresh", "name": "Fresh", "gradient": "linear-gradient(135deg, #119c68 0%, #2f65d8 100%)" }
      ]
    },
    "layout": { "contentSize": "760px", "wideSize": "1180px" },
    "spacing": {
      "units": ["px", "rem", "%", "vw", "vh"],
      "spacingSizes": [
        { "slug": "20", "name": "Small", "size": "1rem" },
        { "slug": "30", "name": "Medium", "size": "1.5rem" },
        { "slug": "40", "name": "Large", "size": "2.5rem" },
        { "slug": "50", "name": "XL", "size": "4rem" }
      ]
    },
    "typography": {
      "customFontSize": true,
      "fluid": false,
      "fontFamilies": [
        { "slug": "inter", "name": "Inter", "fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif" },
        { "slug": "source-serif", "name": "Source Serif", "fontFamily": "Georgia, \"Times New Roman\", serif" }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.875rem" },
        { "slug": "medium", "name": "Medium", "size": "1rem" },
        { "slug": "large", "name": "Large", "size": "1.35rem" },
        { "slug": "x-large", "name": "Display", "size": "4.8rem" }
      ]
    }
  },
  "styles": {
    "color": { "background": "var:preset|color|base", "text": "var:preset|color|ink" },
    "typography": { "fontFamily": "var:preset|font-family|inter", "lineHeight": "1.55" },
    "elements": {
      "heading": { "typography": { "fontWeight": "850", "lineHeight": "1.02" } },
      "link": { "color": { "text": "var:preset|color|primary" } }
    },
    "blocks": {
      "core/button": {
        "border": { "radius": "8px" },
        "color": { "background": "var:preset|color|primary", "text": "var:preset|color|surface" }
      }
    }
  }
}
