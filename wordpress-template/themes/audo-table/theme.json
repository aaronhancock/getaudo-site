{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "border": { "color": true, "radius": true, "style": true, "width": true },
    "color": {
      "custom": true,
      "customDuotone": true,
      "customGradient": true,
      "palette": [
        { "slug": "base", "name": "Base", "color": "#fff9ef" },
        { "slug": "ink", "name": "Ink", "color": "#241713" },
        { "slug": "primary", "name": "Primary", "color": "#9e2f24" },
        { "slug": "accent", "name": "Accent", "color": "#d99a3d" },
        { "slug": "herb", "name": "Herb", "color": "#3f6b48" },
        { "slug": "paper", "name": "Paper", "color": "#ffffff" }
      ],
      "gradients": [
        { "slug": "table-warmth", "name": "Table Warmth", "gradient": "linear-gradient(135deg, #9e2f24 0%, #d99a3d 60%, #3f6b48 100%)" }
      ]
    },
    "layout": { "contentSize": "760px", "wideSize": "1120px" },
    "spacing": { "units": ["px", "rem", "%", "vw", "vh"] },
    "typography": {
      "customFontSize": true,
      "fluid": false,
      "fontFamilies": [
        { "slug": "serif", "name": "Dining Serif", "fontFamily": "Georgia, \"Times New Roman\", serif" },
        { "slug": "system", "name": "System", "fontFamily": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif" }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.9rem" },
        { "slug": "medium", "name": "Medium", "size": "1.05rem" },
        { "slug": "large", "name": "Large", "size": "1.4rem" },
        { "slug": "x-large", "name": "Display", "size": "5rem" }
      ]
    }
  },
  "styles": {
    "color": { "background": "var:preset|color|base", "text": "var:preset|color|ink" },
    "typography": { "fontFamily": "var:preset|font-family|system", "lineHeight": "1.58" },
    "elements": {
      "heading": { "typography": { "fontFamily": "var:preset|font-family|serif", "fontWeight": "700", "lineHeight": "1" } },
      "link": { "color": { "text": "var:preset|color|primary" } }
    }
  }
}
